# Copie este arquivo para ".env" e preencha.

# Porta do servidor local
PORT=3000

# ---------------- Banco na nuvem (Supabase) ----------------
# Com estas duas linhas preenchidas, os dados passam a morar no Supabase:
# o sistema baixa tudo ao ligar e sobe cada alteração. Sem elas, ele usa
# só o banco local (data/royal.db), como antes.
#
# O endereço está em: Supabase > Project Settings > Data API > Project URL
# A chave secreta está em: Project Settings > API Keys > service_role (secret)
# Essa chave dá acesso total — ela fica só aqui no servidor, nunca no navegador.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------------- Chatbot ----------------
# Groq é gratuito: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Alternativas, se um dia quiser trocar
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=

# ---------------- Endereço público ----------------
# Usado nos links que o bot manda no WhatsApp e nos sites dos clientes
URL_PUBLICA=

# ---------------- Outros ----------------
# Token que o Facebook/Make/Zapier envia no webhook de leads
WEBHOOK_TOKEN=royal-webhook

# Recuperação de senha por e-mail (senha de app do Gmail, 16 letras)
SMTP_EMAIL=
SMTP_SENHA=
