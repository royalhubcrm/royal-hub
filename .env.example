# Copie este arquivo para ".env" e preencha.

# Porta do servidor local
PORT=3000

# Chave da API da Anthropic (para o chatbot responder)
# Pegue em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo usado pelo chatbot
ANTHROPIC_MODEL=claude-sonnet-4-5

# Senha simples para abrir o painel (deixe vazio para não pedir senha)
APP_SENHA=

# Token que o Facebook/Make/Zapier envia no webhook de leads
WEBHOOK_TOKEN=royal-webhook
